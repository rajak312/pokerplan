# --- Server ---
PORT=4100
NODE_ENV=development
# Comma-separated list of allowed browser origins (your web app URL[s]).
CORS_ORIGINS=http://localhost:3100
# debug | info | warn | error
LOG_LEVEL=info

# --- Database ---
# Pooled connection used by the running app (Neon: the "-pooler" host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pokerplan
# Direct (non-pooled) connection used by `prisma migrate` (optional locally).
# DIRECT_URL=postgresql://postgres:postgres@localhost:5433/pokerplan

# --- Realtime ---
# How long the facilitator may be offline before the role is handed to someone online.
FACILITATOR_GRACE_MS=30000
